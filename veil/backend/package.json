{
  "name": "veil-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Veil privacy app backend: AWS Lambda + API Gateway + DynamoDB, deployed with AWS SAM.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "sam build",
    "deploy": "sam build && sam deploy --guided"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1166.0",
    "@aws-sdk/client-ssm": "^3.1166.0",
    "@aws-sdk/lib-dynamodb": "^3.1166.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
